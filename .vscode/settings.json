{
  "cSpell.words": [
    "aioboto",
    "CITS",
    "CUDA",
    "devkit",
    "fpdf",
    "huggingface",
    "kesai",
    "noheader",
    "nuscene",
    "pcam",
    "PCDET",
    "pretrained",
    "pyenv",
    "pytest",
    "setuptools",
    "spconv",
    "torchvision",
    "venv"
  ],
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      // "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  // https://github.com/astral-sh/ruff/discussions/4128
  // https://stackoverflow.com/questions/64381297/cant-fully-disable-python-linting-pylance-vscode/75071893#75071893
  "python.analysis.ignore": [
    "*"
  ],
}